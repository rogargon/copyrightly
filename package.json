{
  "name": "copyrightly.io",
  "version": "0.0.3",
  "description": "ÐApp for Copyright Management",
  "scripts": {
    "postinstall": "npm-run-all -p -c patch-webpack patch-bnjs && cd ./node_modules/protractor && npm i webdriver-manager@latest && cd ../.. && ./node_modules/.bin/webdriver-manager update",
    "patch-webpack": "node patch.js",
    "patch-bnjs": "node patch-BN.js",
    "lint": "npm-run-all -p -c solhint nglint",
    "solhint": "solhint ./contracts/*.sol",
    "nglint": "ng lint",
    "network": "ganache-cli -m 'candy maple cake sugar pudding cream honey rich smooth crumble sweet treat'",
    "migrate": "truffle migrate",
    "ethereum-bridge": "ethereum-bridge --dev",
    "test": "npm-run-all -p -c soltest ngtest",
    "soltest": "truffle test test/*.js",
    "ngtest": "ng test --watch=false",
    "ng": "ng",
    "start": "ng serve",
    "build": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --prod",
    "e2e": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng e2e",
    "e2e-local": "npm-run-all e2e-quick e2e-report --continue-on-error",
    "e2e-quick": "ng e2e --dev-server-target= --webdriver-update false",
    "e2e-report": "node e2e/generate-html-report.js",
    "webdriver-update": "webdriver-manager update",
    "debug:migrate": "node $NODE_DEBUG_OPTION ./node_modules/.bin/truffle migrate",
    "debug:soltest": "node $NODE_DEBUG_OPTION ./node_modules/.bin/truffle test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^11.2.4",
    "@angular/common": "^11.2.4",
    "@angular/compiler": "^11.2.4",
    "@angular/core": "^11.2.4",
    "@angular/forms": "^11.2.4",
    "@angular/localize": "^11.2.4",
    "@angular/platform-browser": "^11.2.4",
    "@angular/platform-browser-dynamic": "^11.2.4",
    "@angular/router": "^11.2.4",
    "@fortawesome/fontawesome-free": "^5.15.2",
    "@ng-bootstrap/ng-bootstrap": "^9.0.2",
    "bootstrap-css-only": "^4.4.1",
    "core-js": "^2.5.4",
    "ethereum-ens": "0.7.8",
    "ipfs-http-client": "^49.0.2",
    "rxjs": "^6.6.6",
    "uport-connect": "^1.1.11",
    "web3": "^1.3.4",
    "zone.js": "^0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1102.3",
    "@angular/cli": "~11.2.3",
    "@angular/compiler-cli": "^11.2.4",
    "@angular/language-service": "^11.2.4",
    "@ensdomains/ens": "0.5.0",
    "@truffle/hdwallet-provider": "^1.2.2",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~8.9.4",
    "chai": "^4.1.2",
    "codelyzer": "^6.0.0",
    "cucumber": "^6.0.5",
    "cucumber-html-reporter": "^5.3.0",
    "dotenv": "^8.2.0",
    "eth-ens-namehash": "^2.0.8",
    "ethereum-bridge": "^0.6.2",
    "ganache-cli": "^6.12.2",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.1.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "npm-run-all": "^4.1.5",
    "openzeppelin-solidity": "^2.2.0",
    "protractor": "~7.0.0",
    "protractor-cucumber-framework": "^7.0.2",
    "solhint": "^3.3.3",
    "truffle": "^5.2.2",
    "truffle-security": "^1.7.3",
    "ts-node": "~5.0.1",
    "tslint": "~6.1.3",
    "typescript": "~4.0.7",
    "zos-lib": "^2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogargon/copyrightly.io.git"
  },
  "author": "http://rhizomik.net/~roberto/",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/rogargon/copyrightly.io/issues"
  },
  "browser": {
    "fs": false,
    "child_process": false,
    "net": false
  }
